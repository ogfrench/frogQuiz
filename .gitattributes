# Scripts and configs copied into Linux containers must keep LF endings,
# otherwise a Windows checkout produces `env: 'sh\r': No such file or directory`.
*.sh text eol=lf
Dockerfile* text eol=lf
Caddyfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
