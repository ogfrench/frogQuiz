[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Floors (">=") are the first versions without a known advisory, from the V1 audit (#53, 11 Oct).
uvicorn = "*"
python-socketio = ">=5.16.2"
passlib = "*"
python-jose = "*"
alembic = "*"
email-validator = "*"
python-multipart = ">=0.0.31"
redis = "*"
aiohttp = ">=3.14.3"
# Held to its major: no advisory, and a major bump of the production server is its own change.
gunicorn = "~=23.0"
qrcode = "*"
jinja2 = "*"
argon2-cffi = "*"
aiofiles = "*"
# Held with the server, getmeili/meilisearch v0.28.0 in docker-compose.yml: the two move together.
meilisearch = "==0.37.1"
bleach = ">=6.4.0"
bidict = "*"
xlsxwriter = "*"
authlib = ">=1.6.9"
httpx = "*"
itsdangerous = "*"
py-avataaars-no-png = "*"
cryptography = ">=50.0.0"
pyotp = "*"
minio = "*"
# Held to its major, for the same reason as gunicorn.
xxhash = "~=3.6"
arq = "*"
# Imported directly (frogquiz/helpers). thumbhash-python capped it below 11, so its encoder is
# vendored in frogquiz/helpers/thumbhash.py instead (V1 audit, 11 Oct).
pillow = ">=12.3.0"
python-magic = "*"
openpyxl = "*"
starlette = ">=1.3.1"
pyopenssl = ">=26.0.0"
python-dotenv = ">=1.2.2"
webauthn = "==1.*"
pypng = "*"
# Held: 0.21 and later drop `databases` for SQLAlchemy 2, which frogquiz/db is built on. Its one
# advisory has a dated exception in .github/audit/pip-audit-ignore.txt until that migration.
ormar = "==0.20.2"
pydantic = "*"
pydantic-settings = "*"
asyncpg = "*"
# Imported directly by frogquiz/db/__init__.py; current ormar no longer pulls it in.
databases = "*"
psycopg2-binary = "*"
fastapi = "*"

[dev-packages]
coverage = "*"
pytest = "*"
pytest-asyncio = "*"
flake8 = "*"
black = "*"
pytest-dependency = "*"
pytest-order = "*"
pre-commit = "*"
python-socketio = {extras = ["client"], version = "*"}

[requires]
python_version = "3.13"

[scripts]
format = "black ."
lint = "flake8 frogquiz"
test = "coverage run -m pytest --lf -v --asyncio-mode=strict frogquiz/tests"
worker = "arq frogquiz.worker.WorkerSettings"
