# Copy to .env next to docker-compose.yml, then fill in. docker compose reads it automatically.

# Caddy site address: a bare domain gets an automatic Let's Encrypt cert, :80 is plain HTTP.
SITE_ADDRESS=:80
# Public URL of the deployment, no trailing slash.
ROOT_ADDRESS=http://localhost

POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
SECRET_KEY=change-me

# --- Mail ---
# Leave the whole block blank and set SKIP_EMAIL_VERIFICATION=True to run without
# mail. That also means no password recovery: a forgotten password can then only
# be fixed in the database.
# Any SMTP relay works. Resend, Brevo, Postmark and Mailgun all have a free tier
# that covers a team-sized deployment; a personal Gmail needs an app password and
# will rate-limit you.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
# starttls (587, the usual), ssl (465), or none (local relay only).
MAIL_SECURITY=starttls
# Must be an address the relay is allowed to send for -- a verified sender or a
# domain you have set SPF/DKIM up for. Leaving this as the example address is the
# usual reason mail "sends" and then bounces.
MAIL_ADDRESS=noreply@example.com
MAIL_FROM_NAME=frogQuiz
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=change-me

# Skip the confirmation email at registration. Accounts are then created verified.
SKIP_EMAIL_VERIFICATION=False

# Only when the frontend is hosted separately (Netlify). JSON list, no trailing slash.
# CORS_ORIGINS=["https://frogquiz.netlify.app"]
